[Unit]
Description=myChat room server
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mychat
ReadWritePaths=/opt/mychat /opt/mychat/data
ProtectSystem=false
PrivateTmp=false
Environment=MYCHAT_HTTP_PORT=8080
Environment=CORS_ORIGINS=*
# Copy the Firebase Admin JSON to /opt/mychat/data/firebase-service-account.json
# (never commit it). Uncomment after the file is in place:
# Environment=FIREBASE_CREDENTIALS=/opt/mychat/data/firebase-service-account.json
ExecStart=/opt/mychat/.venv/bin/python /opt/mychat/server.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
