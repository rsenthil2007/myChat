<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions required by myChat when wrapping with WebInto.app / Capacitor / Cordova.

  Features → permissions:
    Chat / Board / SSE sync  → INTERNET, ACCESS_NETWORK_STATE
    Voice notes (record)     → RECORD_AUDIO, MODIFY_AUDIO_SETTINGS
    Voice playback           → (no extra permission; uses MediaPlayer / HTML audio)

  WebInto.app:
    In the builder, enable Microphone / Audio permission for your app URL.
    Upload or paste this list if the dashboard accepts a custom manifest merge.

  Capacitor:
    Copy these <uses-permission> lines into android/app/src/main/AndroidManifest.xml
    (outside the <application> tag).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for getUserMedia / MediaRecorder voice notes -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed by Chromium WebView audio pipeline on many devices -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Optional: only if you later add file export to shared storage -->
    <!-- <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" /> -->

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

</manifest>
